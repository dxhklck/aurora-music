{
  "name": "aurora-music",
  "version": "1.1.0",
  "description": "Aurora Music - 沉浸式跨平台桌面音乐播放器",
  "main": "./out/main/index.js",
  "author": {
    "name": "信息科技练老师",
    "email": "54947961@qq.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "demo:audio": "python scripts/make_demo_audio.py",
    "engine:setup": "python scripts/setup_engine.py",
    "engine:repair": "python scripts/repair_musicdl.py",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "selftest": "npm run build && node scripts/run-selftest.mjs",
    "test": "npm run test:unit",
    "engine:vendor": "python scripts/vendor_engine.py",
    "dist": "npm run engine:vendor && electron-vite build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pinia": "3.0.4",
    "qrcode": "^1.5.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "40.10.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "3.3.13"
  }
}
