node_modules
out
dist
release
*.log
.DS_Store
# 发布资产落点（scripts/publish-gitcode.mjs 的默认 FILES_DIR）：本机补跑 GitCode
# 同步时下载的三件套，单是 exe 就 105 MB，绝不能进仓库
artifacts/

# 仓库根目录下历史的 Python 引擎目录（2026-10-29 已删除）。保留忽略规则，防止误把这类体积重新入库。
# 必须带前导斜杠：否则 `engine/` 会匹配任意层级同名目录，把 src/main/engine/ts 一起忽略掉。
/engine/

# 工作区本地数据
.workbuddy/

# 移动端（Capacitor）工程与产物：体积大，暂不入库
# 方案文档已归档到 docs/archive/android_migration_plan.md（入库存档）
mobile/
build/android/

# TS 引擎验证脚本的临时产物
scripts/engine-ts/.build/

# 本地密钥（GitCode 私人令牌等），永不入库
.env*

# 本地手动打包输出（发布链路故障时的兜底产物，不入库）
dist-local/

# macOS / Linux 的 fpcalc 由 scripts/fetch-fpcalc.mjs 在打包时下载，不入库
# Windows 版必须随仓库提供：CI 的 Fetch fpcalc 在 win32 是 no-op，漏掉就打包出无识别功能的安装包
resources/bin/darwin/
resources/bin/linux-*/
!resources/bin/fpcalc.exe
